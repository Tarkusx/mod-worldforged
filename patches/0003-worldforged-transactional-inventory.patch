+void Player::AppendDetachedInventoryPlacement(CharacterDatabaseTransaction trans, Item* pItem, ItemPosCountVec const& dest) const
+{
+    if (!trans || !pItem || dest.empty())
+        return;
+
+    uint16 pos = dest.back().pos;
+    uint8 bag = pos >> 8;
+    uint8 slot = pos & 255;
+    ObjectGuid::LowType bagGuid = 0;
+    if (Bag* container = GetBagByPos(bag))
+        bagGuid = container->GetGUID().GetCounter();
+
+    CharacterDatabasePreparedStatement* stmt = CharacterDatabase.GetPreparedStatement(CHAR_REP_INVENTORY_ITEM_SYNCH);
+    stmt->SetData(0, GetGUID().GetRawValue());
+    stmt->SetData(1, bagGuid);
+    stmt->SetData(2, slot);
+    stmt->SetData(3, pItem->GetGUID().GetCounter());
+    trans->Append(stmt);
+}
+
+bool Player::AttachPersistedItem(ItemPosCountVec const& dest, Item* pItem, bool update)
+{
+    if (!pItem || dest.empty())
+        return false;
+
+    // This primitive attaches a whole already-persisted item, never merges
+    // into an existing stack (which could destroy the caller-owned pointer).
+    for (ItemPosCount const& position : dest)
+        if (GetItemByPos(position.pos >> 8, position.pos & 255))
+            return false;
+
+    Item* storedItem = StoreItem(dest, pItem, update);
+    if (storedItem != pItem)
+        return false;
+
+    // StoreItem deliberately marks newly attached objects dirty. In this
+    // entry point persistence already committed before the memory attach, so
+    // remove the item and any containing bag from the update queue and leave
+    // both in the durable baseline state.
+    pItem->RemoveFromUpdateQueueOf(this);
+    pItem->SetState(ITEM_UNCHANGED);
+
+    uint16 finalPos = dest.back().pos;
+    if (Bag* bag = GetBagByPos(finalPos >> 8))
+    {
+        bag->RemoveFromUpdateQueueOf(this);
+        bag->SetState(ITEM_UNCHANGED);
+    }
+
+    return true;
+}
